# Canonical normal sanitized-staging runtime contract. This is not a migration
# runner, exact-clone compatibility process, production configuration, or local
# Compose configuration. Copy names into the isolated Railway preproduction
# environment and inject every blank protected value from its secret store.
SPRING_PROFILES_ACTIVE=preproduction
APP_ENV=preproduction
DATABASE_URL=
FLYWAY_BASELINE_ON_MIGRATE=false

# Non-secret immutable release identity.
RELEASE_ID=
GIT_COMMIT_SHA=
BUILD_TIME=

# Exact sanitized-clone binding and production deny boundary. The host,
# database, sentinel, snapshot, and seals are approved values, never guesses.
CLONE_KIND=sanitized
CLONE_SENTINEL_ID=
SOURCE_SNAPSHOT_ID=
CLONE_ALLOWED_HOSTS=
CLONE_ALLOWED_DATABASES=
PRODUCTION_DB_HOST=
PRODUCTION_DB_NAME=
DBOPS_CONFIRMATION=I_ACKNOWLEDGE_THIS_IS_A_DISPOSABLE_CLONE
CLONE_EVIDENCE_SEAL_SHA256=
CLONE_E2E_BEFORE_EVIDENCE_SEAL_SHA256=

# Normal idle staging is mutation-closed. Enable exactly one bounded mode only
# through the documented provisioning, role-E2E, or Resend approval window.
STAGING_ACCOUNT_PROVISIONING_ENABLED=false
STAGING_E2E_MUTATION_ENABLED=false
STAGING_EMAIL_VALIDATION_ENABLED=false
STAGING_EMAIL_VALIDATION_RECIPIENT=
STAGING_PROVISIONING_ALLOWED_EMAILS=

# Exact HTTPS/cookie/CORS topology.
APP_URL=https://staging.viralground.kr
CORS_ORIGINS=https://staging.viralground.kr
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=.staging.viralground.kr
AUTH_COOKIE_SAME_SITE=Lax
JWT_SECRET=
JWT_ISSUER=viralground-api
JWT_AUDIENCE=viralground-web

# One approval record must supply this exact five-value set to both this file
# and the frontend's NEXT_PUBLIC_LEGAL_* variables.
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_AGE14_VERSION=
LEGAL_CREATOR_THIRD_PARTY_VERSION=
LEGAL_MARKETING_VERSION=
PRIVACY_OFFICER_NAME=
PRIVACY_OFFICER_CONTACT=

# Role E2E default: no delivery, no queued dispatch, no scheduled work.
# A separate approved Resend window must set STAGING_EMAIL_VALIDATION_ENABLED=true,
# use the live matching E2E-before seal, allowlist + internal recipients, and
# scheduling/dispatch=true, set STAGING_EMAIL_VALIDATION_RECIPIENT to one exact
# internal address also present in EMAIL_ALLOWED_RECIPIENTS, then restore this block.
EMAIL_MOCK=false
EMAIL_DELIVERY_MODE=disabled
EMAIL_ALLOWED_RECIPIENTS=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAILS=
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_OUTBOX_DISPATCH_ENABLED=false
APP_SCHEDULING_ENABLED=false
INSTAGRAM_SYNC_ENABLED=false
INSTAGRAM_OAUTH_STATE_CLEANUP_ENABLED=false
INSTAGRAM_WEBHOOK_CLEANUP_ENABLED=false
UPLOAD_ORPHAN_CLEANUP_ENABLED=false

# Managed-beta features remain fail-closed.
FEATURE_PAYMENTS_ENABLED=false
PAYMENTS_GATEWAY=disabled
FEATURE_INSTAGRAM_ENABLED=false
FEATURE_UPLOADS_ENABLED=false
FILES_STORAGE=disabled
DEMO_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_CONFIRMATION=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Railway private Redis is encrypted by Railway's private network. Reference
# the Redis service's protected REDIS_URL; do not paste a public TCP URL. The
# exact internal host must also be the sole allowlist entry.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_TRANSPORT=railway-private
REDIS_URL=
REDIS_ALLOWED_HOSTS=
RATE_LIMIT_REDIS_ENVIRONMENT=preproduction
RATE_LIMIT_REDIS_KEY_PREFIX=viralground:preproduction:rate-limit
RATE_LIMIT_AUTH_FAIL_CLOSED=true

# The protected normal runtime retains provider=meta for safe revocation even
# while the public feature flag is false. Inject secrets only in staging.
INSTAGRAM_PROVIDER=meta
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://api.staging.viralground.kr/instagram/meta/oauth/callback
META_INSTAGRAM_FRONTEND_RESULT_URL=https://staging.viralground.kr/creator/mypage
META_INSTAGRAM_TOKEN_ENCRYPTION_KEY=
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Isolated backend staging Sentry identity. SENTRY_RELEASE must equal the full
# lowercase GIT_COMMIT_SHA; approved identity values never contain the DSN key.
SENTRY_DSN=
SENTRY_ENV=preproduction
SENTRY_RELEASE=
SENTRY_APPROVED_HOST=
SENTRY_APPROVED_PROJECT_ID=
SENTRY_TRACES_SAMPLE_RATE=0.05
