# PostgreSQL (Supabase) - JDBC 형식으로 입력
# postgresql://user:password@host:port/dbname 형식이면
# jdbc:postgresql://host:port/dbname?user=user&password=password 로 변환 필요
DATABASE_URL=jdbc:postgresql://host:5432/postgres?user=postgres&password=yourpassword
SPRING_PROFILES_ACTIVE=production

# JWT - 최소 32자 이상의 랜덤 문자열
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_ISSUER=viralground-api
JWT_AUDIENCE=viralground-web
# HTTPS 운영에서는 true. 프론트/API가 같은 루트 도메인의 서로 다른 서브도메인이면
# 두 호스트가 세션/CSRF 쿠키를 공유하도록 점(.)으로 시작하는 공통 도메인을 사용한다.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=.yourdomain.com
AUTH_COOKIE_SAME_SITE=Lax

# 법무 승인 완료 문서의 immutable version ID. blank/draft/placeholder이면 운영 서버는 기동하지 않는다.
# 실제 본문·시행일·문서 해시와 함께 LEGAL_LAUNCH_DECISIONS.md의 승인 기록에 고정한다.
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_AGE14_VERSION=
LEGAL_CREATOR_THIRD_PARTY_VERSION=
LEGAL_MARKETING_VERSION=

# 개인정보 처리방침에 공개하고 내부 책임 지정 문서와 일치시킬 값.
PRIVACY_OFFICER_NAME=
PRIVACY_OFFICER_CONTACT=

# Resend 이메일. 운영 키와 Resend에서 DNS 인증한 회사 도메인의 발신 주소가 모두 필요하다.
# onboarding@resend.dev, 무료 메일 도메인, placeholder/example 값은 운영 기동 시 거부된다.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=https://your-frontend.vercel.app

# 개발/데모용 Mock 모드
# true면 Resend 호출을 건너뛴다. 수신자와 인증 코드는 mock에서도 로그에 남기지 않는다.
# 프로덕션에서는 반드시 false 또는 미설정.
EMAIL_MOCK=false

# 관리자 알림 수신 이메일 (쉼표 구분)
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# (선택) 어드민 부트스트랩 계정
# EMAIL+PASSWORD 둘 다 세팅되어 있고 해당 이메일의 멤버가 DB에 없으면 기동 시 1회 ADMIN 계정 생성.
# 빈 값이면 아무 동작 안 함. 최초 배포 후 계정 생성되면 값 비워도 됨 (이미 존재하면 skip).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Admin

# CORS - 프론트엔드 URL
CORS_ORIGINS=https://your-frontend.vercel.app

# 파일 서명 URL 베이스 — 백엔드의 외부 공개 주소(사용자 브라우저가 직접 도달 가능해야 함).
# 미설정 시 http://localhost:8080 이 되어 배포 환경에서 캠페인 썸네일/로고가 깨진다. 운영에서 반드시 설정!
FILES_PUBLIC_BASE_URL=https://your-backend.up.railway.app
FILES_SIGNING_SECRET=use-a-different-random-secret-from-jwt
# 운영은 S3/R2 호환 객체 저장소만 허용된다. local은 development/test 전용.
FILES_STORAGE=s3
# FILES_LOCAL_DIR=./uploads
FILES_SIGNING_TTL=900
FILES_MAX_IMAGE_SIZE_BYTES=10485760

# Cloudflare R2 예: https://<ACCOUNT_ID>.r2.cloudflarestorage.com / region=auto / path-style=true
# AWS S3는 FILES_S3_ENDPOINT를 비우고 실제 region을 설정하며 path-style=false 권장.
FILES_S3_ENDPOINT=
FILES_S3_REGION=
FILES_S3_BUCKET=
# static: 아래 키 필수. default-chain: IRSA/ECS/EC2/표준 AWS 자격증명 체인 사용.
FILES_S3_CREDENTIALS_MODE=static
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
FILES_S3_SESSION_TOKEN=
FILES_S3_PATH_STYLE=true
FILES_S3_CONNECT_TIMEOUT=3s
FILES_S3_READ_TIMEOUT=10s

# Sentry 에러 추적 (sentry.io에서 프로젝트 생성 후 DSN 복사)
SENTRY_DSN=https://xxxxxxxx@xxx.ingest.sentry.io/xxxxxxx
SENTRY_ENV=local
SENTRY_TRACES_SAMPLE_RATE=0.05

# 런타임 환경. production에서는 INSTAGRAM_PROVIDER=meta가 아니면 서버가 기동을 거부한다.
APP_ENV=production

# Instagram API with Instagram Login (Meta 직접 연동).
# 로컬에서만 mock 허용. 스테이징/운영은 meta를 사용한다.
INSTAGRAM_PROVIDER=meta
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://api.yourdomain.com/instagram/meta/oauth/callback
META_INSTAGRAM_FRONTEND_RESULT_URL=https://yourdomain.com/creator/mypage
# openssl rand -base64 32 등 CSPRNG로 생성. JWT_SECRET과 절대 재사용하지 않는다.
META_INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Meta App Dashboard에 등록할 검증 토큰. 충분히 긴 CSPRNG 값 사용.
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_INSTAGRAM_API_VERSION=v25.0
# 요청 기능 최소 권한. App Review 승인 결과와 반드시 일치시킨다.
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
INSTAGRAM_SYNC_MAX_ITEMS=200

# 결제 공급자를 확정하기 전 관리형 베타는 disabled로 둔다. mock은 dev/test profile에서만 가능.
PAYMENTS_GATEWAY=disabled

# 운영 로그는 구조화 JSON으로 수집한다.
LOG_FORMAT=logstash
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
